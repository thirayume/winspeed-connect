# .env สำหรับ docker compose (คัดลอกเป็น .env ที่ root แล้วแก้ค่า)
# ─────────────────────────────────────────────────────────────

# ── SQL Server (WINSpeed + wf) ──
# โหมด external (default): ชี้ไป remote/Railway
# โหมด self-host (--profile db): ตั้ง REMOTE_DB_SERVER=sqlserver (ชื่อ service)
REMOTE_DB_SERVER=sqlserver
REMOTE_DB_PORT=1433
REMOTE_DB_USER=sa
REMOTE_DB_PASSWORD=CHANGE_ME_Strong#Passw0rd
DB_NAME=dbwins_worldfert9

# ── JWT ── (P0: สุ่มยาว ≥64 ตัวอักษร)
JWT_SECRET=CHANGE_ME_to_random_64_chars_minimum
JWT_EXPIRES_IN=8h

# ── CORS ── (P1: ใส่ domain frontend จริง ห้ามใช้ *)
CORS_ORIGIN=http://localhost:80

# ── Observability / Alerting (FR-030) ──
# webhook สำหรับแจ้งเตือน error (500) + crash + release — รองรับ Slack/Discord/Teams/generic
# เว้นว่าง = ปิดการแจ้งเตือน (telemetry/error-log ยังทำงานปกติ)
ALERT_WEBHOOK_URL=

# ── LINE intake/notify (FR-016) ── (เว้นว่าง = ปิด)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login (OAuth)
# Production callback example: https://api.yourdomain.com/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_LOGIN_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
LINE_LOGIN_SUCCESS_REDIRECT=http://localhost:80

# ── TruckScale sync (pull) ──
TS_SYNC_INTERVAL_MS=60000
# optional push ingest (agent ฝั่งโรงงาน POST /api/truckscale/ingest) — เว้นว่าง = ปิด push
TS_INGEST_SECRET=

# ── TruckScale (MySQL) ──
# external: ชี้ไป Railway · self-host (--profile db): MYSQL_HOST=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=db_truckscale
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_Strong#MysqlP0ss

# ── Frontend build ──
VITE_API_BASE_URL=http://localhost:3000/api

# ── ตัวกันเขียนฐานเครื่องชั่งของโรงงานโดยไม่ตั้งใจ ─────────────────────
# ใส่ชื่อโฮสต์ MySQL "ของจริง" ที่โรงงานใช้ คั่นด้วยจุลภาค
#
# ทำงานอย่างไร: ถ้า NODE_ENV ไม่ใช่ production และ MYSQL_HOST ตรงกับรายชื่อนี้
# คำสั่งเขียนทุกคำสั่งจะถูกปฏิเสธทันที (services/truckscale-db.js)
# ไม่มีผลใด ๆ ตอน NODE_ENV=production
#
# **ถ้าเว้นว่าง ตัวกันจะไม่ทำงานเลย**
#
# ทำไมต้องมี: การชั่งออกหนึ่งครั้งที่ไม่พบใบชั่งเปิดค้าง จะ INSERT ใบใหม่ลง
# tblscale และ tblproduct_detail ซึ่งเป็นสองตารางที่ Crystal Reports ของโรงงาน
# อ่านไปทำรายงานแยกตามสูตรปุ๋ย · ตันจากการทดสอบจึงโผล่ในรายงานของหน่วยงานอื่น
# กรณีที่เกิดจริงบ่อยที่สุดคือคัดลอก .env จาก production มาเครื่องพัฒนา
#
# ใบที่แอปสร้างมีร่องรอยให้ตามลบได้ (sequence ขึ้นต้น WF · one_des ขึ้นต้น WF-SO:)
# แต่ต้องรู้ตัวก่อน ตัวกันนี้จึงถูกกว่าการตามแก้ทีหลังมาก
TS_PRODUCTION_HOSTS=
