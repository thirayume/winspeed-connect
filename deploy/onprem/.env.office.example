# =============================================================
# Sale-App on-prem with the office SQL Server — settings (.env)
# =============================================================
# office-setup.sh copies this file to .env and fills JWT_SECRET / MIGRATE_SECRET with random values.
# The SQL Server administrator types the two database passwords in (nano .env, nano .env.migrator.local).
# Both files are in .gitignore. Never send their contents in chat or e-mail.
# =============================================================

# ── domain (DNS A record → the factory's public IP; ports 80/443 forwarded to this VM) ──
# One domain is enough: the web site forwards /api and /socket.io to the API (Caddyfile), one certificate.
APP_DOMAIN=sale.example.co.th
ACME_EMAIL=it@example.co.th
VITE_API_BASE_URL=https://sale.example.co.th/api
CORS_ORIGIN=https://sale.example.co.th
# the Caddyfile also has a separate API site; with one domain it only listens inside the container
API_DOMAIN=:8081
# while testing inside the LAN only (no domain yet), use instead:
# APP_DOMAIN=:80
# VITE_API_BASE_URL=http://<VM IP>/api
# CORS_ORIGIN=http://<VM IP>

# ── office SQL Server (the WINSpeed database) ──
ONPREM_DB_SERVER=10.0.0.10
# fixed TCP port of the instance (leave empty to resolve ONPREM_DB_INSTANCE through SQL Browser, UDP 1434)
ONPREM_DB_PORT=1433
ONPREM_DB_INSTANCE=
# the test copy first; the real database only on go-live day
ONPREM_DB_NAME=dbwins_worldfert9_test
# what SELECT @@SERVERNAME returns on that server (the app refuses any other server)
ONPREM_EXPECTED_SERVERNAME=WF-SERVER\SQL2008
# what SELECT SERVERPROPERTY('ProductVersion') starts with (SQL Server 2008 R2 = 10.50.)
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
# app login from deploy/onprem/sql/office-logins.sql (never sa)
ONPREM_DB_USER=wf_app
# a password must not contain $ (or put it in single quotes)
ONPREM_DB_PASSWORD=CHANGE_ME
# SQL Server 2008 R2 without the TLS 1.2 update speaks only TLS 1.0: true lowers the client floor (LAN/VPN only)
ONPREM_DB_LEGACY_TLS=true
ONPREM_DB_ENCRYPT=true

# ── app secrets (office-setup.sh fills them) ──
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
MIGRATE_SECRET=CHANGE_ME

# ── features at go-live (go-live checklist A4) ──
LINE_EXPIRY_NOTIFICATION_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=
LINE_LOGIN_SUCCESS_REDIRECT=

TZ=Asia/Bangkok
HTTP_PORT=80
HTTPS_PORT=443
