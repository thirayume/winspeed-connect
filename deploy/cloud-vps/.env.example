# WorldFert Cloud VPS - copy to .env and replace every CHANGE_ME value.
# Never commit .env. The Windows deploy script transfers it over SSH/SCP.
# Use shell-safe secrets containing A-Z, a-z, 0-9 and _ . : @ % + , - only.

# Public application domains (DNS A records -> SERVER_PUBLIC_IP)
ROOT_DOMAIN=example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
PORTAINER_DOMAIN=portainer.example.com
MSSQL_DOMAIN=mssql.example.com
MYSQL_DOMAIN=mysql.example.com
ACME_EMAIL=it@example.com
VITE_API_BASE_URL=https://api.example.com/api
CORS_ORIGIN=https://app.example.com

# Databases
DB_NAME=dbwins_worldfert9
MYSQL_DATABASE=db_truckscale
MSSQL_TEST_DATABASE=dbwins_worldfert9_test
MYSQL_TEST_DATABASE=db_truckscale_test

# ── ปลายทางฐานข้อมูลของ stack ทดสอบ ────────────────────────────
# ไม่ตั้ง = ใช้คอนเทนเนอร์ mssql/mysql บน VPS เหมือนเดิม
#
# ตั้งค่าเหล่านี้เมื่อต้องการให้ test ใช้ฐานเดียวกับที่หน้างานใช้จริง
# (WINSpeed บนเครื่องผู้ดูแลชี้ Azure · ฐานเครื่องชั่งอยู่ Railway)
#   TEST_MSSQL_SERVER=20.255.185.14
#   TEST_MSSQL_PORT=1433
#   MSSQL_TEST_DATABASE=dbwins_worldfert9
#   TEST_MYSQL_HOST=reseau.proxy.rlwy.net
#   TEST_MYSQL_PORT=42508
#   MYSQL_TEST_DATABASE=db_truckscale
#
# ⚠ ชี้ test ไปฐานจริงเมื่อไร ต้องตั้ง TS_PRODUCTION_HOSTS ให้ครบด้วย
#   ไม่งั้น test จะเขียนทับฐานเครื่องชั่งของจริงได้
TEST_MSSQL_SERVER=
TEST_MSSQL_PORT=
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=

MSSQL_PID=Express
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_MSSQL_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_Strong_MySQL_root_password
MYSQL_USER=wfapp
MYSQL_PASSWORD=CHANGE_ME_Strong_MySQL_app_password
WF_READER_PASSWORD=CHANGE_ME_Strong_reader_password
WF_OWNER_PASSWORD=CHANGE_ME_Strong_owner_password

# Application secrets
JWT_SECRET=CHANGE_ME_random_at_least_32_characters
DEFAULT_SEED_PASSWORD=CHANGE_ME_initial_admin_password
JWT_EXPIRES_IN=8h
MIGRATE_SECRET=CHANGE_ME_random_migrate_secret
TS_INGEST_SECRET=CHANGE_ME_random_ingest_secret
TS_SYNC_INTERVAL_MS=60000
APP_VERSION=1.0.0

# Resource limits for a 4 vCPU / 16 GB server
TZ=Asia/Bangkok
MSSQL_MEMORY_LIMIT_MB=6144
MSSQL_MEM_LIMIT=8G
MYSQL_BUFFER_POOL=1G
MYSQL_MEM_LIMIT=2G

# Separate test frontend/backend resource limits. Test domains are derived as
# test.ROOT_DOMAIN and api-test.ROOT_DOMAIN; test JWT/operation secrets are
# generated on the VPS and stored outside the repository.
TEST_BACKEND_MEM_LIMIT=1G
TEST_FRONTEND_MEM_LIMIT=256M

# Public listeners. Access is controlled by provider firewall + UFW allowlist.
DB_BIND_IP=0.0.0.0
MSSQL_PUBLIC_PORT=1433
MYSQL_PUBLIC_PORT=3306
HTTP_PORT=80
HTTPS_PORT=443

# Host paths prepared by server/prepare-server.sh
TRANSFER_ROOT=/srv/wf-transfer
MSSQL_CERT_DIR=/opt/worldfert/secrets/mssql
MYSQL_CERT_DIR=/opt/worldfert/secrets/mysql
MSSQL_CONFIG_FILE=/opt/worldfert/secrets/mssql/mssql.conf
PORTAINER_ADMIN_PASSWORD_FILE=/opt/worldfert/secrets/portainer/admin-password

# Backup policy: Sunday 02:00 Asia/Bangkok, keep ten weekly generations.
BACKUP_RETAIN_DAYS=70
BACKUP_MIN_FREE_GB=12

# LINE Login (optional)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=
LINE_LOGIN_SUCCESS_REDIRECT=

# Development write guard (optional; production mode does not use this guard)
TS_PRODUCTION_HOSTS=
