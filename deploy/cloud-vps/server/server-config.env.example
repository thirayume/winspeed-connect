# Copy to server-config.env on the Windows administrator workstation.
DEPLOY_USER=wfdeploy
SFTP_USER=wfbackup
SSH_PORT=22
APP_ROOT=/opt/worldfert
TRANSFER_ROOT=/srv/wf-transfer
SERVER_TIMEZONE=Asia/Bangkok

# Public names/IP used in database TLS certificates.
SERVER_PUBLIC_IP=203.0.113.10
MSSQL_DOMAIN=mssql.example.com
MYSQL_DOMAIN=mysql.example.com
MSSQL_ALT_DOMAINS=
MYSQL_ALT_DOMAINS=

# Comma-separated IPv4/IPv6 CIDRs. Use the office/public client IPs.
ADMIN_ALLOWED_CIDRS=203.0.113.20/32
SFTP_ALLOWED_CIDRS=203.0.113.20/32
DB_ALLOWED_CIDRS=203.0.113.20/32

# Deliberate emergency escape hatch. Keep false for normal production.
# If true and DB_ALLOWED_CIDRS=0.0.0.0/0, databases are reachable worldwide.
ALLOW_DATABASES_FROM_ANYWHERE=false
