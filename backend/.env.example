# ── WorldFert Sale-App (WF-SaleApp) · Backend Environment Example ─
# Choose DB_MODE: onprem (default for UAT/PROD) or local_uat

# ── Option 1: On-Prem SQL Server (Windows Server 2008 R2) ────────
DB_MODE=onprem
LOCAL_ONLY_MODE=false
ALLOW_DEV_SA=false
ONPREM_DB_SERVER=172.16.30.169
ONPREM_DB_PORT=1433
ONPREM_DB_INSTANCE=SQL2008
ONPREM_DB_NAME=dbwins_worldfert9_uat
ONPREM_TARGET_KIND=uat
ONPREM_EXPECTED_SERVERNAME=R740-SRV\SQL2008
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
ONPREM_DB_USER=sa
ONPREM_DB_PASSWORD=
ONPREM_MIGRATOR_USER=sa
ONPREM_MIGRATOR_PASSWORD=
ONPREM_DB_ENCRYPT=true
ONPREM_DB_LEGACY_TLS=true
ONPREM_SWITCHABLE_DATABASES=dbwins_worldfert9,dbwins_worldfert2,dbwins_worldfert9_uat

# ── TruckScale (MySQL Scale Database) ───────────────────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=db_truckscale
MYSQL_USER=
MYSQL_PASSWORD=
TS_PRODUCTION_HOSTS=reseau.proxy.rlwy.net,mysql/db_truckscale

# ── Authentication & Security ───────────────────────────────────
JWT_SECRET=CHANGE_ME_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
E2E_PASSWORD=

# ── LINE Login (OAuth) ──────────────────────────────────────────
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
LINE_LOGIN_SUCCESS_REDIRECT=http://localhost:5173

# ── Server & Application Runtime ────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
EXPORT_OUTPUT_PATH=./exports

# ── Operational Feature Flags ───────────────────────────────────
COUPON_NATIVE_POSTING_ENABLED=false
DISABLE_BACKGROUND_WORKERS=true
ALLOW_LIVE_REHEARSAL=false
