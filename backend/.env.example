# Local development. Backend loads backend/.env. See docs/DEPLOYMENT.md.
DB_MODE=local_uat
LOCAL_DB_SERVER=localhost\SQLEXPRESS
DB_NAME=dbwins_worldfert9
# Explicit SQL-auth server for Docker; no provider/IP fallback.
REMOTE_DB_SERVER=
REMOTE_DB_PORT=1433
REMOTE_DB_USER=wf_owner
REMOTE_DB_PASSWORD=
# Hostinger connection used by --targets remote_b
REMOTE_B_DB_SERVER=
REMOTE_B_DB_PORT=1433
REMOTE_B_DB_USER=wf_test
REMOTE_B_DB_PASSWORD=
REMOTE_B_DB_NAME=dbwins_worldfert9_test_v2
# Optional SSH tunnel; use loopback REMOTE_B_DB_SERVER when enabled.
REMOTE_B_SSH_HOST=
REMOTE_B_SSH_USER=
REMOTE_B_SSH_KEY=
REMOTE_B_SSH_REMOTE_PORT=1433
JWT_SECRET=CHANGE_ME_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
EXPORT_OUTPUT_PATH=./exports
ENFORCE_PASSWORD_CHANGE=false
E2E_PASSWORD=
E2E_CUSTOMER=
DEFAULT_SEED_PASSWORD=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
LINE_LOGIN_SUCCESS_REDIRECT=http://localhost:5173

# Isolated UAT/rehearsal: fill from the reviewed private runbook; never use sa.
# Existing process variables take precedence over backend/.env (dotenv override=false).
LOCAL_UAT_SERVER=
LOCAL_UAT_DB=dbwins_worldfert9_local_uat
LOCAL_UAT_USER=wf_uat_app
LOCAL_UAT_PASSWORD=
LOCAL_REHEARSAL_SERVER=
LOCAL_REHEARSAL_DB=dbwins_worldfert9_rehearsal
LOCAL_REHEARSAL_USER=wf_uat_migrator
LOCAL_REHEARSAL_PASSWORD=
# Rehearsal CLI uses explicit separate fields; no opaque connection-string override.
ALLOW_LIVE_REHEARSAL=false
REHEARSAL_APPROVED_PROFILE=
REHEARSAL_APPROVED_REMOTE_HOST=
REHEARSAL_TRUST_SERVER_CERTIFICATE=false
COUPON_NATIVE_POSTING_ENABLED=false
DISABLE_BACKGROUND_WORKERS=true

LOCAL_ONLY_MODE=false
ALLOW_RESTORED_LOCAL_UAT=false
LOCAL_UAT_MIGRATOR_USER=wf_uat_migrator
LOCAL_UAT_MIGRATOR_PASSWORD=
