# ── SQL Server ────────────────────────────────────────────────
# ค่าเริ่มต้น = remote (Azure) — App กับ WINSpeed ต้องอยู่ฐานเดียวกันตอนทดสอบ
# ตั้ง DB_MODE="local" เฉพาะเมื่อจงใจทำงานกับฐานบนเครื่องพัฒนา
DB_MODE="remote"
LOCAL_DB_SERVER="localhost\SQLEXPRESS"
# If SQL Browser is off, use named pipe, for example:
# LOCAL_DB_SERVER="np:\\.\pipe\MSSQL$SQLEXPRESS\sql\query"
REMOTE_DB_SERVER="20.255.185.14"
REMOTE_DB_PORT="1433"
REMOTE_DB_USER="wf_owner"
REMOTE_DB_PASSWORD="YOUR_WF_OWNER_PASSWORD"
DB_NAME="dbwins_worldfert9"

# wf_reader = read-only, ใช้สำหรับ master data และ views
DB_USER="wf_reader"
DB_PASSWORD="ChangeMe_Strong#2026"

# wf_owner = full access บน schema wf (ต้องสร้างก่อน run migrate)
DB_OWNER_USER="wf_owner"
DB_OWNER_PASSWORD="YOUR_WF_OWNER_PASSWORD"

# ── ปลายทางที่ 2: remote_b (Coolify / Hetzner) ────────────────
# ใช้โดย `npm run migrate` (ค่าเริ่มต้น = ยิงทุกปลายทาง) ผ่าน scripts/migrate-targets.js
# DB ไม่ได้เปิดสู่อินเทอร์เน็ต → ต่อผ่าน SSH tunnel (สคริปต์เปิดให้อัตโนมัติถ้ายังไม่เปิด)
# ปล่อยว่างไว้ = ข้าม target นี้ (ไม่ error)
REMOTE_B_DB_SERVER="127.0.0.1"
REMOTE_B_DB_PORT="14330"
REMOTE_B_DB_USER="sa"
REMOTE_B_DB_PASSWORD="YOUR_COOLIFY_SA_PASSWORD"
REMOTE_B_DB_NAME="dbwins_worldfert9"

# ข้อมูล SSH สำหรับเปิด tunnel อัตโนมัติ (ถ้าเปิดค้างไว้เองแล้วจะใช้ของเดิม ไม่ไปปิด)
REMOTE_B_SSH_HOST="178.104.120.21"
REMOTE_B_SSH_USER="root"
REMOTE_B_SSH_KEY="C:\Users\<you>\.ssh\wf-key"
REMOTE_B_SSH_REMOTE_PORT="1433"

# ── TruckScale (MySQL — pool แยก ไม่เกี่ยวกับ DB_MODE) ─────────
# ⚠ อย่าตั้ง DB_MODE=mysql — DB_MODE ใช้คุม SQL Server (local/remote) เท่านั้น

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="change_this_to_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="8h"

# LINE Login (OAuth)
# Callback URL in LINE Developers must match LINE_LOGIN_CALLBACK_URL.
LINE_LOGIN_CHANNEL_ID="YOUR_LINE_LOGIN_CHANNEL_ID"
LINE_LOGIN_CHANNEL_SECRET="YOUR_LINE_LOGIN_CHANNEL_SECRET"
LINE_LOGIN_CALLBACK_URL="http://localhost:3000/api/auth/line/callback"
LINE_LOGIN_SUCCESS_REDIRECT="http://localhost:5173"

# ── Server ────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"

# ── WINSpeed Import ───────────────────────────────────────────

# โฟลเดอร์ที่ backend เก็บไฟล์ที่สร้าง
EXPORT_OUTPUT_PATH="C:\wssale-exports"

# โฮสต์ MySQL ของเครื่องชั่งที่ถือเป็น "ของจริง" คั่นด้วยจุลภาค
# ถ้า NODE_ENV ไม่ใช่ production แล้ว MYSQL_HOST ตรงกับรายการนี้ ระบบจะปฏิเสธการเขียนทันที
# ต้องตั้งในทุกสภาพแวดล้อม มิฉะนั้นตัวป้องกันจะไม่ทำงาน
# ── ตัวกันเขียนฐานเครื่องชั่งของโรงงานโดยไม่ตั้งใจ ─────────────────────
# ใส่ชื่อโฮสต์ MySQL "ของจริง" ที่โรงงานใช้ คั่นด้วยจุลภาค
#
# ทำงานอย่างไร: ถ้า NODE_ENV ไม่ใช่ production และ MYSQL_HOST ตรงกับรายชื่อนี้
# ไม่มีผลใด ๆ ตอน NODE_ENV=production
#
# **ถ้าเว้นว่าง ตัวกันจะไม่ทำงานเลย**
#
# ทำไมต้องมี: การชั่งออกหนึ่งครั้งที่ไม่พบใบชั่งเปิดค้าง จะ INSERT ใบใหม่ลง
# tblscale และ tblproduct_detail ซึ่งเป็นสองตารางที่ Crystal Reports ของโรงงาน
# อ่านไปทำรายงานแยกตามสูตรปุ๋ย · ตันจากการทดสอบจึงโผล่ในรายงานของหน่วยงานอื่น
# กรณีที่เกิดจริงบ่อยที่สุดคือคัดลอก .env จาก production มาเครื่องพัฒนา
#
# ใบที่แอปสร้างมีร่องรอยให้ตามลบได้ (sequence ขึ้นต้น WF · one_des ขึ้นต้น WF-SO:)
# แต่ต้องรู้ตัวก่อน ตัวกันนี้จึงถูกกว่าการตามแก้ทีหลังมาก
# host = กันทั้งโฮสต์ · host/database = กันเฉพาะฐานนั้นบนโฮสต์นั้น
# ── รหัสผ่านที่ไม่เก็บไว้ในซอร์ส (ที่เก็บนี้เป็นสาธารณะ) ─────────────────
# รหัสของบัญชีทดสอบ e2e_* — สคริปต์ verify-*.js ทุกตัวต้องใช้ค่านี้
# เดิมมีค่าปริยายเป็นรหัสจริงเขียนไว้ในสคริปต์ ซึ่งอ่านได้จาก GitHub
E2E_PASSWORD=
# รหัสตั้งต้นของทุกบัญชีตอน seed — ปล่อยว่างแล้ว seed_admin จะสุ่มให้
# และพิมพ์ออกหน้าจอครั้งเดียว ให้จดไปเปลี่ยนทันทีหลัง login ครั้งแรก
DEFAULT_SEED_PASSWORD=

# ลูกค้าที่ใช้ทดสอบ e2e (ไม่บังคับ) — ไม่ตั้งก็ใช้รายแรกที่ค้นเจอ
E2E_CUSTOMER=
