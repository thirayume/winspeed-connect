# R740-SRV PRODUCTION target (dbwins_worldfert9). Deploys stay disabled until the owner
# approves go-live. Enabling also needs a reviewed production profile: the on-prem guard
# currently rejects any login that can open dbwins_worldfert9, and a database backup
# step before migrations. Do not flip SALEAPP_DEPLOY_ENABLED by itself.
SALEAPP_DEPLOY_ENABLED=false
SALEAPP_STACK=prod
SALEAPP_COMPOSE_PROJECT=saleapp-prod
SALEAPP_MIGRATOR_LOGIN=wf_r740_prod_migrator
ONPREM_DB_SERVER=172.16.30.169
ONPREM_DB_PORT=1433
ONPREM_DB_INSTANCE=
ONPREM_DB_NAME=dbwins_worldfert9
ONPREM_EXPECTED_SERVERNAME=R740-SRV\SQL2008
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
ONPREM_DB_USER=wf_r740_prod_app
ONPREM_DB_ENCRYPT=true
ONPREM_DB_LEGACY_TLS=true
APP_DOMAIN=172.16.30.169
HTTP_PORT=8090
HTTPS_PORT=443
CORS_ORIGIN=https://172.16.30.169
VITE_API_BASE_URL=/api
TZ=Asia/Bangkok
NATIVE_BOOKING_AI_ENABLED=false
NATIVE_DELIVERY_104_ENABLED=false
