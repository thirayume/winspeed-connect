# R740-SRV PRODUCTION target: dbwins_worldfert9, the live WINSpeed database. Prepared but
# disabled. Setting SALEAPP_DEPLOY_ENABLED=true is the go-live decision, made by the owner
# through a reviewed commit on main (see README "PROD go-live"). With it, deploy.bat prod
# plans first, refuses to apply migrations without a fresh pre-deploy backup, and starts
# Caddy with the UAT root CA so clients keep the one certificate they already trust.
SALEAPP_DEPLOY_ENABLED=false
SALEAPP_STACK=prod
SALEAPP_COMPOSE_PROJECT=saleapp-prod
SALEAPP_MIGRATOR_LOGIN=wf_r740_prod_migrator
# Apply needs dbwins_worldfert9_predeploy_*.bak newer than this many minutes in this folder,
# written by sql/r740-prod-backup.sql (SQL Server's own backup folder).
SALEAPP_BACKUP_DIR=/mnt/d/MSSQL/MSSQL10_50.SQL2008/Backup
SALEAPP_BACKUP_MAX_AGE_MINUTES=120
# Reuse this Compose project's Caddy root CA (copied volume to volume on this server only).
SALEAPP_SHARE_CA_FROM=saleapp-uat
ONPREM_TARGET_KIND=production
ONPREM_DB_SERVER=172.16.30.169
ONPREM_DB_PORT=1433
ONPREM_DB_INSTANCE=
ONPREM_DB_NAME=dbwins_worldfert9
ONPREM_EXPECTED_SERVERNAME=R740-SRV\SQL2008
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
ONPREM_DB_USER=wf_r740_prod_app
ONPREM_DB_ENCRYPT=true
# SQL Server 2008 R2 SP2 (10.50.4000) offers TLS 1.0 only.
ONPREM_DB_LEGACY_TLS=true
APP_DOMAIN=172.16.30.169
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGIN=https://172.16.30.169
VITE_API_BASE_URL=/api
TZ=Asia/Bangkok
NATIVE_BOOKING_AI_ENABLED=false
NATIVE_DELIVERY_104_ENABLED=false
# Polling (screen refresh) and outbox worker; neither writes dbo (owner 2026-10-24).
DISABLE_BACKGROUND_WORKERS=false
# Databases a permitted role may switch to (owner 2026-10-25).
ONPREM_SWITCHABLE_DATABASES=dbwins_worldfert9,dbwins_worldfert9-uat,dbwins_worldfert2
