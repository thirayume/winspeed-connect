# R740-SRV UAT target: reviewed, non-secret pins read by r740-deploy.sh as KEY=literal
# lines (not sourced). They override the same keys in D:\SaleApp\uat\config\.env, which
# holds only secrets. Change a pin here through review, never on the server.
SALEAPP_DEPLOY_ENABLED=true
SALEAPP_STACK=uat
SALEAPP_COMPOSE_PROJECT=saleapp-uat
SALEAPP_MIGRATOR_LOGIN=wf_r740_uat_migrator
# Containers reach SQL Server on the Windows host through its LAN address.
ONPREM_DB_SERVER=172.16.30.169
ONPREM_DB_PORT=1433
ONPREM_DB_INSTANCE=
ONPREM_DB_NAME=dbwins_worldfert9-uat
ONPREM_TARGET_KIND=uat
ONPREM_EXPECTED_SERVERNAME=R740-SRV\SQL2008
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
ONPREM_DB_USER=wf_r740_uat_app
ONPREM_DB_ENCRYPT=true
# SQL Server 2008 R2 SP2 (10.50.4000) offers TLS 1.0 only.
ONPREM_DB_LEGACY_TLS=true
APP_DOMAIN=172.16.30.169
HTTP_PORT=8091
HTTPS_PORT=8444
CORS_ORIGIN=https://172.16.30.169:8444
VITE_API_BASE_URL=/api
TZ=Asia/Bangkok
NATIVE_BOOKING_AI_ENABLED=false
NATIVE_DELIVERY_104_ENABLED=false
