# Invoked by deploy-r740.ps1 only. Defaults to SELECT-only plan; no app/migrator grants.
$ErrorActionPreference='Stop'
trap {
 $category='NATIVE_RELEASE_SQL_OR_DRIVER_FAILURE'
 if($_.Exception.Message -match '^NATIVE_RELEASE_[A-Z_]+$'){$category=$_.Exception.Message}
 [Console]::Error.WriteLine($category);exit 1
}
$payload=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__PAYLOAD__')) | ConvertFrom-Json
$apply=__APPLY__
$approvedPlan='__PLAN_HASH__'
if($env:COMPUTERNAME -ne 'R740-SRV'){throw 'NATIVE_RELEASE_HOST_INVALID'}
if($payload.database -notin @('dbwins_worldfert9','dbwins_worldfert9_uat','dbwins_worldfert9_uat_v3') -or $payload.server -ne 'R740-SRV\SQL2008'){throw 'NATIVE_RELEASE_TARGET_INVALID'}
$connection=New-Object Data.SqlClient.SqlConnection("Server=R740-SRV\SQL2008;Database=$($payload.database);Integrated Security=SSPI;Application Name=Reviewed Native Writer Release")
$tx=$null
function Hash([string]$s){
 $sha=[Security.Cryptography.SHA256]::Create()
 try{return ([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($s.Replace("`r`n","`n"))))).Replace('-','').ToLower()}finally{$sha.Dispose()}
}
function Command([string]$text,$values=@{}){
 # The restore wrapper invokes this template in a child ScriptBlock. Use its
 # transaction scope; $script:tx refers to the wrapper file and can be empty.
 $q=$connection.CreateCommand();$q.CommandTimeout=30;if($tx){$q.Transaction=$tx};$q.CommandText=$text
 foreach($key in $values.Keys){[void]$q.Parameters.AddWithValue('@'+$key,$values[$key])};return $q
}
function Rows([string]$text,$values=@{}){
 $q=Command $text $values;$r=$q.ExecuteReader();$out=@()
 try{while($r.Read()){$o=[ordered]@{};for($i=0;$i -lt $r.FieldCount;$i++){$v=$r.GetValue($i);if($v -is [DBNull]){$v=$null};$o[$r.GetName($i)]=$v};$out+=,[pscustomobject]$o}}finally{$r.Close();$q.Dispose()};return ,$out
}
function Exec([string]$text,$values=@{}){$q=Command $text $values;try{[void]$q.ExecuteNonQuery()}finally{$q.Dispose()}}
function Matches($actual,$expected){
 if($actual.Count -ne $expected.Count){return $false}
 foreach($e in $expected){$found=@($actual|Where-Object {$_[0] -eq $e[0] -and $_[1] -eq $e[1]})
 if($found.Count -ne 1 -or $found[0][2] -ne $e[2] -or $found[0][3] -ne $e[3]){return $false}}
 return $true
}
function Read-Plan{
 $identity=(Rows "SELECT CONVERT(nvarchar(128),SERVERPROPERTY('ServerName')) ServerName,DB_NAME() DbName,DB_ID() DbId,IS_SRVROLEMEMBER('sysadmin') IsDba")[0]
 if($identity.ServerName -ne $payload.server -or $identity.DbName -ne $payload.database -or $identity.IsDba -ne 1){throw 'NATIVE_RELEASE_DBA_TARGET_REQUIRED'}
 $ledger=Rows 'SELECT FileName,Checksum FROM wf.SchemaMigration ORDER BY FileName'
 foreach($m in $payload.migrations){$hit=@($ledger|Where-Object {$_.FileName -eq $m.file});if($hit.Count -ne 1 -or $hit[0].Checksum -ne $m.hash){throw 'NATIVE_RELEASE_LEDGER_MISMATCH'}}
 $actual=Rows $payload.metadataQuery;$fingerprints=@()
 foreach($r in $actual){if(-not $r.definition){throw 'NATIVE_RELEASE_METADATA_INVISIBLE'};$fingerprints+=,@($r.TableName.ToLower(),$r.name.ToLower(),[int]$r.is_disabled,(Hash $r.definition))}
 $baseline=Matches $fingerprints $payload.baseline;$bridge=Matches $fingerprints $payload.expected
 $legacy=$false
 if($payload.native116.enabled -and $payload.priorExpected){$legacy=Matches $fingerprints $payload.priorExpected}
 $priorDirect=$false
 if($payload.native116.enabled -and $payload.priorDirectExpected){$priorDirect=Matches $fingerprints $payload.priorDirectExpected}
 if(-not $baseline -and -not $bridge -and -not $legacy -and -not $priorDirect){throw 'NATIVE_RELEASE_METADATA_DRIFT'}
 if($payload.native116.enabled -and ($bridge -or $priorDirect)){
  foreach($order in $payload.orders){$row=@($actual|Where-Object {$_.name -eq $order.name});$field=if($order.event -eq 'DELETE'){'FirstDelete'}else{'LastInsert'}
   if($row.Count -ne 1 -or [int]$row[0].$field -ne 1){throw 'NATIVE_RELEASE_TRIGGER_ORDER_DRIFT'}}
 }
 $reader=(Rows "SELECT OBJECT_DEFINITION(OBJECT_ID('wf.usp_ReadNativeDocumentMetadata')) Body,USER_NAME(execute_as_principal_id) PrincipalName FROM sys.sql_modules WHERE object_id=OBJECT_ID('wf.usp_ReadNativeDocumentMetadata')")[0]
 $readerBody=$reader.Body.Replace("`r`n","`n").Trim().Replace('CREATE PROCEDURE ','ALTER PROCEDURE ')
 $expectedReader=$payload.readerSql.Replace("`r`n","`n").Trim()
 if($payload.database -eq 'dbwins_worldfert9_uat'){$readerBody=$readerBody.Replace("WITH EXECUTE AS 'wf_r740_uat_migrator_v2'",'WITH EXECUTE AS SELF')}
 if($readerBody -cne $expectedReader){throw 'NATIVE_RELEASE_METADATA_READER_CHANGED'}
 $reviewers=Rows "SELECT u.Id,u.IsActive,u.MustChangePassword,
  CASE WHEN EXISTS(SELECT 1 FROM wf.vUserRole r JOIN wf.RoleProfile p ON p.Code=r.RoleCode WHERE r.UserId=u.Id AND p.BaseRole='ADMIN')
  AND NOT EXISTS(SELECT 1 FROM wf.vUserRole r WHERE r.UserId=u.Id AND r.RoleCode='SEPARATION') THEN 1 ELSE 0 END IsAdmin
  FROM wf.AppUser u WHERE u.Id IN(@approver,@actor)" @{approver=[int]$payload.approverId;actor=[int]$payload.actorId}
 foreach($id in @($payload.approverId,$payload.actorId)){$u=@($reviewers|Where-Object {$_.Id -eq $id});if($u.Count -ne 1 -or -not $u[0].IsActive -or $u[0].MustChangePassword -or $u[0].IsAdmin -ne 1){throw 'NATIVE_RELEASE_REVIEWER_NOT_ACTIVE_ADMIN'}}
 $busy=(Rows "SELECT
  (SELECT COUNT(*) FROM wf.CouponNativeCutAuthorization WHERE State='ACTIVE') OldAuthorizations,
  (SELECT COUNT(*) FROM wf.CouponNativeEditHold h WHERE NOT EXISTS(SELECT 1 FROM wf.CouponNativeEditRelease r WHERE r.EditId=h.EditId)) OldHolds,
  (SELECT COUNT(*) FROM wf.CouponBridgePermit WHERE ReleasedAtUtc IS NULL AND State<>'CANCELLED') BridgePermits,
  (SELECT COUNT(*) FROM wf.Native116Stage WHERE State='PENDING') Native116Stages,
  (SELECT COUNT(*) FROM wf.NativeDocumentRequest WHERE Status IN('PENDING','APPROVED') AND ExpiresAtUtc>GETUTCDATE()) WriterRequests,
  (SELECT COUNT(*) FROM wf.NativeDeliveryRequest WHERE Status IN('PENDING','APPROVED') AND ExpiresAt>GETUTCDATE()) Legacy104,
  (SELECT COUNT(*) FROM wf.NativeManualRedemptionRequest WHERE Status IN('PENDING','APPROVED') AND ExpiresAt>GETUTCDATE()) Legacy116,
  (SELECT COUNT(*) FROM wf.CouponReservation WHERE Status='RESERVED' AND ReservedQty>ISNULL(ConsumedQty,0) AND (ExpiresAt IS NULL OR ExpiresAt>GETUTCDATE() OR wf.fn_CouponBridgeReservationHeld(Id)=1)) LiveReservations")[0]
 if($busy.OldAuthorizations -or $busy.OldHolds -or $busy.BridgePermits -or $busy.Native116Stages -or $busy.WriterRequests -or $busy.Legacy104 -or $busy.Legacy116){throw 'NATIVE_RELEASE_UNFINISHED_WORK'}
 if($payload.action -eq 'DISABLE' -and $busy.LiveReservations){throw 'NATIVE_RELEASE_RESERVATIONS_PREVENT_DISABLE'}
 $contract=Rows "SELECT PolicyVersion,MetadataHash,IsEnabled,ApprovedById,ApprovedActorId FROM wf.NativeWriterContract WHERE ServerName=@server AND DatabaseName=DB_NAME() AND PolicyVersion=@policy" @{server=$payload.server;policy=$payload.policy}
 if($payload.refreshParentReleaseId){
  if($payload.database -ne 'dbwins_worldfert9_uat' -or $payload.action -ne 'ENABLE' -or -not $bridge){throw 'NATIVE_RELEASE_REFRESH_UAT_ONLY'}
  $parent=(Rows "SELECT TOP 1 ReleaseId,Action,ModulesHash,ApprovedById,ActorId FROM wf.NativeWriterRelease WHERE DatabaseName='dbwins_worldfert9' AND ServerName=@server ORDER BY CreatedAtUtc DESC,ReleaseId DESC" @{server=$payload.server})[0]
  $copied=(Rows "SELECT IsEnabled,MetadataHash,ApprovedById,ApprovedActorId FROM wf.NativeWriterContract WHERE DatabaseName='dbwins_worldfert9' AND ServerName=@server AND PolicyVersion=@policy" @{server=$payload.server;policy=$payload.policy})[0]
  if(-not $parent -or -not $copied -or $parent.ReleaseId.ToString() -ne $payload.refreshParentReleaseId -or $parent.Action -ne 'ENABLE' -or
   $parent.ModulesHash -ne $payload.moduleHash -or $parent.ApprovedById -ne $payload.approverId -or $parent.ActorId -ne $payload.actorId -or
   -not $copied.IsEnabled -or $copied.MetadataHash -ne $payload.metadataHash -or $copied.ApprovedById -ne $payload.approverId -or $copied.ApprovedActorId -ne $payload.actorId){throw 'NATIVE_RELEASE_REFRESH_PARENT_CHANGED'}
  $events=Rows "SELECT AfterJson FROM wf.ChangeEvent WHERE EntityType='NATIVE_WRITER_RELEASE' AND EntityId=@id" @{id=$payload.refreshParentReleaseId}
  if($events.Count -ne 1){throw 'NATIVE_RELEASE_REFRESH_SOURCE_AUDIT_REQUIRED'}
  $sourceState=$events[0].AfterJson|ConvertFrom-Json
  if($sourceState.sourceRevision -cne $payload.sourceRevision -or $sourceState.writerEnabled -ne $true -or $sourceState.bridgeEnabled -ne $true){throw 'NATIVE_RELEASE_REFRESH_SOURCE_REVISION_CHANGED'}
 }
 $bridgeContract=Rows "SELECT Enabled,ModulesHash FROM wf.CouponBridgeContract WHERE Version='116-BRIDGE-v1'"
 if($bridgeContract.Count -ne 1 -or ($bridgeContract[0].Enabled -and $bridgeContract[0].ModulesHash -ne $payload.moduleHash -and
  -not($legacy -and $bridgeContract[0].ModulesHash -eq $payload.priorModuleHash) -and
  -not($priorDirect -and $bridgeContract[0].ModulesHash -eq $payload.priorDirectModuleHash))){throw 'NATIVE_RELEASE_BRIDGE_CONTRACT_CHANGED'}
 $nativePolicy=Rows "SELECT Enabled,ModulesHash,wf.fn_Native116HooksReady() HooksReady,ProgramName,CONVERT(varchar(172),LoginSid,1) LoginSidHex,ApprovedById FROM wf.Native116Contract WHERE Version='NATIVE-116-DIRECT-v1'"
 if($nativePolicy.Count -ne 1 -or ($nativePolicy[0].Enabled -and -not $payload.native116.enabled)){throw 'NATIVE_RELEASE_PROTOCOL_DOWNGRADE_FORBIDDEN'}
 if($legacy -and $nativePolicy[0].Enabled){throw 'NATIVE_RELEASE_DIRECT_STATE_INCONSISTENT'}
 if($nativePolicy[0].Enabled -and (($nativePolicy[0].ModulesHash -cne $payload.moduleHash -and
  -not($priorDirect -and $nativePolicy[0].ModulesHash -ceq $payload.priorDirectModuleHash)) -or $nativePolicy[0].HooksReady -ne 1)){throw 'NATIVE_RELEASE_DIRECT_ATTESTATION_CHANGED'}
 if($priorDirect -and $nativePolicy[0].ModulesHash -cne $payload.priorDirectModuleHash){throw 'NATIVE_RELEASE_DIRECT_STATE_INCONSISTENT'}
 if($payload.refreshParentReleaseId -and $payload.native116.enabled){
  if($sourceState.native116Policy.enabled -ne $true -or $sourceState.native116Policy.programName -cne $payload.native116.programName -or
   $sourceState.native116Policy.loginSidHex -cne $payload.native116.loginSidHex -or -not $nativePolicy[0].Enabled -or
   $nativePolicy[0].ProgramName -cne $payload.native116.programName -or
   $nativePolicy[0].LoginSidHex.ToLower() -cne $payload.native116.loginSidHex -or $nativePolicy[0].ApprovedById -ne $payload.approverId){throw 'NATIVE_RELEASE_REFRESH_DIRECT_POLICY_CHANGED'}
 }
 if($payload.action -eq 'DISABLE' -and -not $bridge){throw 'NATIVE_RELEASE_NOT_ACTIVE'}
 $first=(Rows "SELECT COUNT(*) Conflicts FROM sys.triggers WHERE parent_id=OBJECT_ID('dbo.WFCoupon') AND OBJECTPROPERTY(object_id,'ExecIsFirstUpdateTrigger')=1 AND name<>'WF_CouponNativeConsume'")[0].Conflicts
 if($first){throw 'NATIVE_RELEASE_TRIGGER_ORDER_CONFLICT'}
 if($payload.native116.enabled){
  $firstHead=(Rows "SELECT COUNT(*) Conflicts FROM sys.triggers WHERE parent_id=OBJECT_ID('dbo.WFRedemtionHD') AND OBJECTPROPERTY(object_id,'ExecIsFirstDeleteTrigger')=1 AND name<>'WF_CouponNativeEditHeadHook'")[0].Conflicts
  $lastAudit=(Rows "SELECT COUNT(*) Conflicts FROM sys.triggers WHERE parent_id=OBJECT_ID('dbo.SMAudit') AND OBJECTPROPERTY(object_id,'ExecIsLastInsertTrigger')=1 AND name<>'WF_Native116AuditHook'")[0].Conflicts
  if($firstHead -or $lastAudit){throw 'NATIVE_RELEASE_TRIGGER_ORDER_CONFLICT'}
 }
 $state=[ordered]@{server=$identity.ServerName;database=$identity.DbName;dbId=$identity.DbId;action=$payload.action;sourceRevision=$payload.sourceRevision;sourceHash=$payload.sourceHash;
  approverId=$payload.approverId;actorId=$payload.actorId;reason=$payload.reason;readerPrincipal=$reader.PrincipalName;readerHash=(Hash $reader.Body);fingerprints=$fingerprints;
  writerContract=$contract;bridgeContract=$bridgeContract;native116Policy=$nativePolicy;desiredNative116Policy=$payload.native116;busy=$busy;
  triggerOrder=@($actual|Select-Object TableName,name,FirstDelete,LastInsert,FirstUpdate)}
 $state.sourceProtocol=if($bridge){'CURRENT'}elseif($priorDirect){'PRIOR_DIRECT'}elseif($legacy){'LEGACY_BRIDGE'}else{'BASELINE'}
 $state.releaseCount=(Rows 'SELECT COUNT(*) Total FROM wf.NativeWriterRelease')[0].Total
 $state.businessHistory=(Rows 'SELECT (SELECT COUNT(*) FROM wf.NativeDocumentReceipt)+(SELECT COUNT(*) FROM wf.CouponBridgeDocument)+(SELECT COUNT(*) FROM wf.Native116Stage) Total')[0].Total
 $state.guardMode=if($state.businessHistory -gt 0){'RETAIN_HISTORY_GUARDS'}else{'PRISTINE_BASELINE'}
 $planHash=Hash ($state|ConvertTo-Json -Depth 8 -Compress)
 return @{hash=$planHash;state=$state}
}
try{
 $connection.Open()
 if(-not $apply){$plan=Read-Plan;Write-Output ('NATIVE_RELEASE_PLAN='+($plan|ConvertTo-Json -Depth 9 -Compress));return}
 if(-not $payload.refreshParentReleaseId -and $approvedPlan -notmatch '^[a-f0-9]{64}$'){throw 'NATIVE_RELEASE_PLAN_APPROVAL_REQUIRED'}
 $tx=$connection.BeginTransaction([Data.IsolationLevel]::Serializable)
 Exec "SET LOCK_TIMEOUT 10000;SET XACT_ABORT ON;DECLARE @r int;EXEC @r=sp_getapplock @Resource='WF_NATIVE_WRITER_RELEASE',@LockMode='Exclusive',@LockOwner='Transaction',@LockTimeout=10000;IF @r<0 RAISERROR('NATIVE_RELEASE_BUSY',16,1);
 EXEC @r=sp_getapplock @Resource='WF_NATIVE_DOCUMENTS_V3',@LockMode='Exclusive',@LockOwner='Transaction',@LockTimeout=10000;IF @r<0 RAISERROR('NATIVE_RELEASE_BUSY',16,1);"
 $plan=Read-Plan
 if($payload.refreshParentReleaseId){$approvedPlan=$plan.hash}
 if($plan.hash -ne $approvedPlan){throw 'NATIVE_RELEASE_PLAN_CHANGED'}
 $values=@{server=$payload.server;policy=$payload.policy;metadata=$payload.metadataHash;module=$payload.moduleHash;approver=[int]$payload.approverId;actor=[int]$payload.actorId;reason=$payload.reason}
 if($payload.action -eq 'ENABLE'){
  if(-not $payload.refreshParentReleaseId){
   foreach($hook in $payload.hooks){
    if($hook.name -eq 'WF_Native116AuditHook' -and -not (Rows "SELECT OBJECT_ID('dbo.WF_Native116AuditHook','TR') Id")[0].Id){Exec $hook.sql.Replace('ALTER TRIGGER ','CREATE TRIGGER ')}else{Exec $hook.sql}
   }
   Exec "ENABLE TRIGGER dbo.WF_CouponNativeConsume ON dbo.WFCoupon;
   ENABLE TRIGGER dbo.WF_CouponReservationGuard ON dbo.WFCoupon;
   ENABLE TRIGGER dbo.WF_CouponNativeEditHeadHook ON dbo.WFRedemtionHD;
   ENABLE TRIGGER dbo.WF_CouponNativeEditDetailHook ON dbo.WFRedemtionDT;
   EXEC sp_settriggerorder @triggername='dbo.WF_CouponNativeConsume',@order='First',@stmttype='UPDATE';"
   if($payload.native116.enabled){
    Exec "ENABLE TRIGGER dbo.WF_Native116AuditHook ON dbo.SMAudit;
     EXEC sp_settriggerorder @triggername='dbo.WF_CouponNativeEditHeadHook',@order='First',@stmttype='DELETE';
     EXEC sp_settriggerorder @triggername='dbo.WF_Native116AuditHook',@order='Last',@stmttype='INSERT';"
   }
  }
  Exec "UPDATE wf.NativeWriterContract SET IsEnabled=1,MetadataHash=@metadata,ApprovedById=@approver,ApprovedActorId=@actor,ApprovedAtUtc=GETUTCDATE(),Evidence=@reason
   WHERE ServerName=@server AND DatabaseName=DB_NAME() AND PolicyVersion=@policy;
   IF @@ROWCOUNT=0 INSERT wf.NativeWriterContract(ServerName,DatabaseName,PolicyVersion,MetadataHash,IsEnabled,ApprovedById,ApprovedActorId,ApprovedAtUtc,Evidence)
    VALUES(@server,DB_NAME(),@policy,@metadata,1,@approver,@actor,GETUTCDATE(),@reason);
   UPDATE wf.CouponBridgeContract SET Enabled=1,ModulesHash=@module,ApprovedById=@approver,ActorId=@actor,ApprovedAtUtc=GETUTCDATE(),Evidence=@reason WHERE Version='116-BRIDGE-v1';" $values
  if($payload.native116.enabled){
   $values.nativeProgram=$payload.native116.programName;$values.nativeSid=$payload.native116.loginSidHex
   foreach($hook in $payload.hooks){
    $hookValues=@{name=$hook.name;table=$hook.table;definition=$hook.sql.Replace('ALTER TRIGGER ','CREATE TRIGGER ').Replace("`r`n","`n");module=$payload.moduleHash}
    Exec "UPDATE wf.Native116HookContract SET TableName=@table,ExpectedDefinition=@definition,ModulesHash=@module WHERE TriggerName=@name;
     IF @@ROWCOUNT=0 INSERT wf.Native116HookContract(TriggerName,TableName,ExpectedDefinition,ModulesHash) VALUES(@name,@table,@definition,@module);" $hookValues
   }
   Exec "UPDATE wf.Native116Contract SET Enabled=1,ProgramName=@nativeProgram,LoginSid=CONVERT(varbinary(85),@nativeSid,1),ModulesHash=@module,ApprovedById=@approver,ApprovedAtUtc=GETUTCDATE(),Evidence=@reason WHERE Version='NATIVE-116-DIRECT-v1';IF @@ROWCOUNT<>1 RAISERROR('NATIVE_RELEASE_DIRECT_POLICY_MISSING',16,1);
    IF wf.fn_Native116HooksReady()<>1 RAISERROR('NATIVE_RELEASE_DIRECT_ATTESTATION_FAILED',16,1);" $values
  }
 }elseif($plan.state.businessHistory -eq 0){
  foreach($hook in $payload.originalHooks){Exec $hook.sql}
  if($payload.native116.enabled){Exec "DROP TRIGGER dbo.WF_Native116AuditHook;UPDATE wf.Native116Contract SET Enabled=0 WHERE Version='NATIVE-116-DIRECT-v1';"}
  Exec "DISABLE TRIGGER dbo.WF_CouponNativeConsume ON dbo.WFCoupon;
   DISABLE TRIGGER dbo.WF_CouponReservationGuard ON dbo.WFCoupon;
   DISABLE TRIGGER dbo.WF_CouponNativeEditHeadHook ON dbo.WFRedemtionHD;
   DISABLE TRIGGER dbo.WF_CouponNativeEditDetailHook ON dbo.WFRedemtionDT;
   UPDATE wf.NativeWriterContract SET IsEnabled=0 WHERE ServerName=@server AND DatabaseName=DB_NAME() AND PolicyVersion=@policy;
   UPDATE wf.CouponBridgeContract SET Enabled=0 WHERE Version='116-BRIDGE-v1';" $values
 }else{
  # Completed history still needs the bridge to guard edits and cancellation.
  # Pausing must not reopen a WinSpeed bypass around the return/settlement ledger.
  Exec "UPDATE wf.NativeWriterContract SET IsEnabled=0 WHERE ServerName=@server AND DatabaseName=DB_NAME() AND PolicyVersion=@policy;" $values
 }
 $actual=Rows $payload.metadataQuery;$fingerprints=@()
 foreach($r in $actual){$fingerprints+=,@($r.TableName.ToLower(),$r.name.ToLower(),[int]$r.is_disabled,(Hash $r.definition))}
 $expected=if($payload.action -eq 'ENABLE' -or $plan.state.businessHistory -gt 0){$payload.expected}else{$payload.baseline}
 if(-not (Matches $fingerprints $expected)){throw 'NATIVE_RELEASE_POST_METADATA_MISMATCH'}
 if($payload.native116.enabled -and ($payload.action -eq 'ENABLE' -or $plan.state.businessHistory -gt 0)){
  foreach($order in $payload.orders){$row=@($actual|Where-Object {$_.name -eq $order.name});$field=if($order.event -eq 'DELETE'){'FirstDelete'}else{'LastInsert'}
   if($row.Count -ne 1 -or [int]$row[0].$field -ne 1){throw 'NATIVE_RELEASE_POST_TRIGGER_ORDER_MISMATCH'}}
 }
 $values.plan=$approvedPlan;$values.action=$payload.action;$values.release=[Guid]::NewGuid();$values.baseline=($payload.originalHooks|ConvertTo-Json -Depth 6 -Compress)
 $values.before=($plan.state|ConvertTo-Json -Depth 9 -Compress)
 $values.after=([ordered]@{writerEnabled=($payload.action -eq 'ENABLE');bridgeEnabled=($payload.action -eq 'ENABLE' -or $plan.state.businessHistory -gt 0);native116Policy=$payload.native116;
  triggerOrder=@($actual|Select-Object TableName,name,FirstDelete,LastInsert,FirstUpdate);fingerprints=$fingerprints;guardMode=$plan.state.guardMode;sourceRevision=$payload.sourceRevision;parentReleaseId=$payload.refreshParentReleaseId}|ConvertTo-Json -Depth 9 -Compress)
 $values.parent=if($payload.refreshParentReleaseId){[Guid]$payload.refreshParentReleaseId}else{[DBNull]::Value}
 Exec "INSERT wf.NativeWriterRelease(ReleaseId,ParentReleaseId,Action,ServerName,DatabaseName,PlanHash,ModulesHash,BaselineHooksJson,ApprovedById,ActorId,Reason,SqlLogin)
  VALUES(@release,@parent,@action,@server,DB_NAME(),@plan,@module,@baseline,@approver,@actor,@reason,ORIGINAL_LOGIN());
  INSERT wf.ChangeEvent(EntityType,EntityId,Action,ReasonCode,ReasonText,BeforeJson,AfterJson,UserId,ActorUserId)
  VALUES('NATIVE_WRITER_RELEASE',CONVERT(varchar(36),@release),@action,'REVIEWED_RELEASE',@reason,@before,@after,CONVERT(varchar(20),@approver),CONVERT(varchar(20),@actor));" $values
 if('__ROLLBACK_TEST__' -eq 'true'){
  if($payload.database -ne 'dbwins_worldfert9_uat_v3'){throw 'NATIVE_RELEASE_ROLLBACK_QA_ONLY'}
  $tx.Rollback();$tx.Dispose();$tx=$null;Write-Output 'NATIVE_RELEASE_QA_ROLLBACK_PASS'
 }else{$tx.Commit();$tx.Dispose();$tx=$null;Write-Output ('NATIVE_RELEASE_APPLIED='+$payload.action)}
}finally{if($tx -and $tx.Connection){$tx.Rollback()};$connection.Dispose()}
