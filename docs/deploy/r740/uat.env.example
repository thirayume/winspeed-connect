# Copy to D:\SaleApp\uat\config\.env on R740-SRV and fill in. Never commit or share it.
# Only secrets go here. Server, database, login names, ports and flags are pinned in
# docs/deploy/r740/targets/uat.env and override anything set in this file.
# Put a value that contains $ in single quotes, for example 'ab$cd'.

# Password of the SQL login wf_r740_uat_app (set by IT in SSMS).
ONPREM_DB_PASSWORD=

# A new random value, unique to this environment (not a SQL password). Changing it signs
# every user out. Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_EXPIRES_IN=8h
