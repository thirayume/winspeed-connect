# Copy to D:\SaleApp\prod\config\.env on R740-SRV at go-live and fill in. Never commit or share it.
# Only secrets go here. Server, database, login names, ports and flags are pinned in
# docs/deploy/r740/targets/prod.env and override anything set in this file.
# Put a value that contains $ in single quotes, for example 'ab$cd'.

# Password of the SQL login wf_r740_prod_app (set by IT in SSMS; not the UAT password).
ONPREM_DB_PASSWORD=

# A new random value for production only (not the UAT one, not a SQL password). Changing it
# signs every user out. Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_EXPIRES_IN=8h
