# UAT ingress: Caddy's local CA serves the configured clone host over HTTPS.
# Caddy automatically redirects HTTP to HTTPS when the site has a host name/IP.
{
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
	# Browsers send no SNI for an IP address (R740: 172.16.30.169), and behind WSL/Docker
	# NAT the listener address is the container's own, so name the certificate to use.
	default_sni {$APP_DOMAIN}
	# The automatic HTTP->HTTPS redirect drops a non-standard HTTPS port (8444 would
	# become 443, another stack on R740) and outranks a catch-all HTTP site.
	auto_https disable_redirects
}

http://:{$HTTP_PORT} {
	redir https://{host}:{$HTTPS_PORT}{uri} 308
}

{$APP_DOMAIN} {
	tls internal
	encode gzip

	@api path /api/* /socket.io/* /uploads/*
	handle @api {
		reverse_proxy backend:3000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
