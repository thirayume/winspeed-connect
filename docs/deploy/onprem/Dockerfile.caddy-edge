# Caddy and the community DNS provider are version-pinned. No secret enters this build.
# DuckDNS v0.5.0 tag resolves to 4ec390a9330122fa1ba10686ba221be0801df6ed.
FROM caddy:2.11.7-builder-alpine AS builder
RUN xcaddy build v2.11.7 --with github.com/caddy-dns/duckdns@v0.5.0

FROM caddy:2.11.7-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
COPY Caddyfile.r740-edge /etc/caddy/Caddyfile
