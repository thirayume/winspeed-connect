# Copy this file to .env, then replace every blank/CHANGE_ME value locally.
# .env is ignored by Git. Never put live passwords in this template or in chat.
HTTP_PORT=8080
HTTPS_PORT=8444
TZ=Asia/Bangkok
VITE_API_BASE_URL=/api
APP_DOMAIN=localhost
CORS_ORIGIN=https://localhost:8444

# UAT clone only. Docker Desktop reaches SQL on Windows through this DNS name.
# A separate native WSL Docker Engine instead needs its verified Windows gateway IP.
ONPREM_DB_SERVER=host.docker.internal
# This local UAT target uses a fixed TCP port; leave the instance name blank.
ONPREM_DB_PORT=51433
ONPREM_DB_INSTANCE=
ONPREM_DB_NAME=dbwins_worldfert9_uat2
# Must exactly match SELECT @@SERVERNAME on the approved clone target.
ONPREM_EXPECTED_SERVERNAME=AMYOU-YOGA7\V2008R2
ONPREM_PRODUCT_VERSION_PREFIX=10.50.
# Use a dedicated least-privileged login. The app explicitly refuses sa in on-prem mode.
ONPREM_DB_USER=wf_local_uat_app
ONPREM_DB_PASSWORD=
ONPREM_DB_ENCRYPT=true
# Only enable the legacy TLS floor for this connection after IT verifies the SQL patch level.
ONPREM_DB_LEGACY_TLS=false

# Initial-only native booking AI pilot, restricted to the pinned local UAT2 target.
# Requires migration 152 and a new app-origin booking captured after enabling.
# This does not enable 104, native 116, or invoice posting.
NATIVE_BOOKING_AI_ENABLED=false

# Generate a unique random value locally; do not reuse a SQL password.
JWT_SECRET=
JWT_EXPIRES_IN=8h
