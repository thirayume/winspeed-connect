# ── Database (Remote SQL Server) ─────────────────────────────
DB_MODE=remote
# For local Windows Auth use LOCAL_DB_SERVER=localhost\SQLEXPRESS.
# If SQL Browser is off, use named pipe, for example:
# LOCAL_DB_SERVER=np:\\.\pipe\MSSQL$SQLEXPRESS\sql\query
REMOTE_DB_SERVER=20.255.185.14
REMOTE_DB_PORT=1433
REMOTE_DB_USER=sa
REMOTE_DB_PASSWORD=YourPasswordHere
DB_NAME=dbwins_worldfert9

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# บังคับเปลี่ยนรหัสผ่านตั้งต้น (D6-02)
# เปิดเฉพาะเซิร์ฟเวอร์ที่ใช้งานจริง — บัญชีที่ยังใช้รหัสผ่านซ้ำจะบันทึกข้อมูลไม่ได้
# จนกว่าจะตั้งรหัสใหม่เอง (อ่านข้อมูลได้ตามปกติ) และจะเจอหน้าบังคับเปลี่ยนรหัสตอนล็อกอิน
# บนเครื่องนักพัฒนาปล่อยว่างไว้ ไม่งั้นชุดทดสอบและงานพัฒนาจะติดขัดโดยไม่ได้ลดความเสี่ยงจริง
ENFORCE_PASSWORD_CHANGE=false


# LINE Login (OAuth)
# Callback URL in LINE Developers must match LINE_LOGIN_CALLBACK_URL.
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_LOGIN_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
LINE_LOGIN_SUCCESS_REDIRECT=http://localhost:5173

# ── CORS — comma-separated origins allowed to call the API ───
# On-premise (same machine):  http://localhost
# On-premise (LAN IP):        http://192.168.1.100
# Public domain:              https://yourdomain.com
CORS_ORIGIN=http://localhost

# ── Frontend build-time ───────────────────────────────────────
# On-premise: http://<server-ip>:3000/api
# Public:     https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# ── ตัวกันเขียนฐานเครื่องชั่งของโรงงานโดยไม่ตั้งใจ ─────────────────────
# ใส่ชื่อโฮสต์ MySQL "ของจริง" ที่โรงงานใช้ คั่นด้วยจุลภาค
#
# ทำงานอย่างไร: ถ้า NODE_ENV ไม่ใช่ production และ MYSQL_HOST ตรงกับรายชื่อนี้
# คำสั่งเขียนทุกคำสั่งจะถูกปฏิเสธทันที (services/truckscale-db.js)
# ไม่มีผลใด ๆ ตอน NODE_ENV=production
#
# **ถ้าเว้นว่าง ตัวกันจะไม่ทำงานเลย**
#
# ทำไมต้องมี: การชั่งออกหนึ่งครั้งที่ไม่พบใบชั่งเปิดค้าง จะ INSERT ใบใหม่ลง
# tblscale และ tblproduct_detail ซึ่งเป็นสองตารางที่ Crystal Reports ของโรงงาน
# อ่านไปทำรายงานแยกตามสูตรปุ๋ย · ตันจากการทดสอบจึงโผล่ในรายงานของหน่วยงานอื่น
# กรณีที่เกิดจริงบ่อยที่สุดคือคัดลอก .env จาก production มาเครื่องพัฒนา
#
# ใบที่แอปสร้างมีร่องรอยให้ตามลบได้ (sequence ขึ้นต้น WF · one_des ขึ้นต้น WF-SO:)
# แต่ต้องรู้ตัวก่อน ตัวกันนี้จึงถูกกว่าการตามแก้ทีหลังมาก
TS_PRODUCTION_HOSTS=
